<!-- <></> -->
<CONFIG>
    <!-- Apart from username, leave Azure_Settings unchanged -->
    <!-- Completely remove the <Username> element and script will prompt -->
    <Azure_Settings>
        <!-- <Username></Username> -->
        <baseUrl>https://graph.microsoft.com/beta/deviceAppManagement/</baseUrl>
        <logRequestUris>$true</logRequestUris>
        <logHeaders>$false</logHeaders>
        <logContent>$true</logContent>
        <azureStorageUploadChunkSizeInMb>6l</azureStorageUploadChunkSizeInMb>
        <sleep>5</sleep>
    </Azure_Settings>
    <IntuneWin_Settings>
        <!-- Edit the AppType element - supported options are MSI, EXE or PS1 -->
        <AppType>PS1</AppType>
        <!-- Edit the installCmdLine element when using the EXE or MSI AppType -->
        <installCmdLine></installCmdLine>
        <!-- Edit the uninstallCmdLine element when using the EXE or MSI AppType -->
        <uninstallCmdLine></uninstallCmdLine>
        <!-- Edit the RuleType element - supported options are TAGFILE , FILE or REGTAG -->
        <!-- Ignored if AppType is MSI-->
        <RuleType>TAGFILE</RuleType>
        <!-- Edit the FilePath element when using the FILE RuleType -->
        <FilePath></FilePath>
        <!-- !!! Do NOT Edit the ReturnCodeType element !!! -->
        <ReturnCodeType>DEFAULT</ReturnCodeType>
        <!-- Edit the InstallExperience element - supported options are System or User -->
        <InstallExperience>System</InstallExperience>
        <!-- Edit the PackageName element to match the name of the .PS1 script that the IntuneWinAppUtil should reference -->
        <!-- For MSI or EXE AppType - this must be the name of the MSI or executable file in the ..\Source folder - without the .exe in the name -->
        <PackageName>SubfolderNameHere</PackageName>
        <!-- Edit the displayName element that will be shown for the imported package in the Intune console -->
        <displayName>MCS Intune name here</displayName>
        <!-- Edit the Description element that will be shown for the imported package in the Intune console -->
        <Description>Description goes here</Description>
        <!-- Edit the displayVersion element that will be shown for the imported package in the Intune console -->
        <displayVersion>1.0</displayVersion>
        <!-- Edit the Publisher name if required -->
        <Publisher>Microsoft</Publisher>
        <!-- Edit the Category element that will be shown for the imported package in the Intune console -->
        <Category>Business</Category>
        <!-- Edit the LogoFile element to provide a logo shown in Company Portal -->
        <LogoFile>MSLogo.png</LogoFile>
        <!-- Edit the EntraGroupName element used for the required/available/uninstall group creation -->
        <!-- Note: AADGroupName is still supported for backward compatibility but EntraGroupName is preferred -->
        <EntraGroupName>MIP-WIN10-OBJECT-CONFIG-GroupName Here v1.0</EntraGroupName>
        <!-- Optional: Edit the ScopeTag element to assign an Intune scope tag to the application -->
        <!-- If left empty or removed, no scope tag will be applied unless specified via -ScopeTagName parameter -->
        <!-- The -ScopeTagName parameter takes precedence over this setting -->
        <ScopeTag></ScopeTag>

        <!-- ===================== EXTENDED SETTINGS (all optional) ===================== -->

        <!-- App Information - These settings are optional and can be removed if not needed -->
        <!-- Show this app as a featured app in Company Portal (true/false) -->
        <!-- <IsFeatured>false</IsFeatured> -->
        <!-- URL for more information about the app -->
        <!-- <InformationUrl>https://example.com/info</InformationUrl> -->
        <!-- URL for privacy information about the app -->
        <!-- <PrivacyInformationUrl>https://example.com/privacy</PrivacyInformationUrl> -->
        <!-- Developer name -->
        <!-- <Developer>Developer Name</Developer> -->
        <!-- Owner name -->
        <!-- <Owner>Owner Name</Owner> -->
        <!-- Additional notes about the app -->
        <!-- <Notes>Any notes about this application</Notes> -->

        <!-- Install Experience Settings -->
        <!-- Maximum time in minutes the app install is allowed to run (default: 60) -->
        <!-- <MaxRunTimeInMinutes>60</MaxRunTimeInMinutes> -->
        <!-- Device restart behavior: basedOnReturnCode, allow, suppress, force (default: suppress) -->
        <!-- <DeviceRestartBehavior>suppress</DeviceRestartBehavior> -->

        <!-- System Requirements - Set to 0 or remove to not enforce -->
        <!-- Minimum free disk space required in MB -->
        <!-- <MinimumFreeDiskSpaceInMB>0</MinimumFreeDiskSpaceInMB> -->
        <!-- Minimum physical memory required in MB -->
        <!-- <MinimumMemoryInMB>0</MinimumMemoryInMB> -->
        <!-- Minimum number of logical processors required -->
        <!-- <MinimumNumberOfProcessors>0</MinimumNumberOfProcessors> -->
        <!-- Minimum CPU speed required in MHz -->
        <!-- <MinimumCpuSpeedInMHz>0</MinimumCpuSpeedInMHz> -->
        <!-- Allowed architectures: x64, x86 (comma-separated) -->
        <!-- <AllowedArchitectures>x64,x86</AllowedArchitectures> -->
        <!-- Minimum supported OS version: v10_1903, v10_1909, v10_2004, v10_20H2, v10_21H1, v11_21H2, v11_22H2, v11_23H2 -->
        <!-- <MinimumSupportedOS>v10_1903</MinimumSupportedOS> -->

        <!-- Custom Return Codes - Comma-separated code:type pairs -->
        <!-- Types: failed, success, softReboot, hardReboot, retry -->
        <!-- <CustomReturnCodes>3010:softReboot,1641:hardReboot,1618:retry</CustomReturnCodes> -->

        <!-- Dependencies - Comma-separated list of app display names this app depends on -->
        <!-- <Dependencies>Microsoft Visual C++ Redistributable,Microsoft .NET Runtime</Dependencies> -->
        <!-- Dependency type: autoInstall (install dependency if needed) or detect (just check if installed) -->
        <!-- <DependencyType>autoInstall</DependencyType> -->

        <!-- Supersedence - Comma-separated list of app display names this app supersedes -->
        <!-- <Supersedence>Old App v1.0,Old App v2.0</Supersedence> -->
        <!-- Supersedence type: update (upgrade to new app) or replace (uninstall old, install new) -->
        <!-- <SupersedenceType>update</SupersedenceType> -->

        <!-- PowerShell Script Detection - Alternative to TAGFILE/FILE/REGTAG detection -->
        <!-- Path to detection script relative to package folder -->
        <!-- <DetectionScriptFile>Detection\Detect-MyApp.ps1</DetectionScriptFile> -->
        <!-- Enforce code signature check on detection script (true/false) -->
        <!-- <DetectionScriptEnforceSignatureCheck>false</DetectionScriptEnforceSignatureCheck> -->
        <!-- Run detection script as 32-bit process (true/false) -->
        <!-- <DetectionScriptRunAs32Bit>false</DetectionScriptRunAs32Bit> -->
    </IntuneWin_Settings>
</CONFIG>